    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.6.1/nouislider.min.js"></script>
    <script>
    // Функция добавления в корзину
function addToCart(productId, quantity = 1, color = '', size = '') {
    const formData = new FormData();
    formData.append('action', 'add');
    formData.append('product_id', productId);
    formData.append('quantity', quantity);
    formData.append('color', color);
    formData.append('size', size);

    fetch('cart.php', {
        method: 'POST',
        body: formData,
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Обновляем счетчик корзины
            const cartCount = document.querySelector('.cart-count');
            if (cartCount) {
                cartCount.textContent = data.cart_count;
                cartCount.style.display = 'inline-flex';
            }
            
            // Показываем уведомление
            showNotification('✅ Товар добавлен в корзину', 'success');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        showNotification('❌ Ошибка при добавлении в корзину', 'danger');
    });
}

// Функция для показа уведомлений
function showNotification(message, type = 'success') {
    const notification = document.createElement('div');
    notification.className = `alert alert-${type} position-fixed top-0 end-0 m-3`;
    notification.style.zIndex = '9999';
    notification.style.minWidth = '300px';
    notification.style.boxShadow = '0 5px 15px rgba(0,0,0,0.2)';
    notification.innerHTML = `
        <div class="d-flex align-items-center">
            <i class="bi bi-${type === 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill'} me-2"></i>
            ${message}
        </div>
    `;
    document.body.appendChild(notification);
    
    setTimeout(() => {
        notification.remove();
    }, 3000);
}

// Инициализация кнопок добавления в корзину
document.addEventListener('DOMContentLoaded', function() {
    // Назначаем обработчики на все кнопки "В корзину"
    document.querySelectorAll('.add-to-cart-btn').forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            
            // Находим карточку товара
            const card = this.closest('.card-body') || this.closest('.product-card');
            if (!card) return;
            
            // Получаем данные
            const productId = this.dataset.productId;
            const selectedColor = card.querySelector('.selected-color')?.value || '';
            const selectedSize = card.querySelector('.selected-size')?.value || '';
            const selectedSizeSelect = card.querySelector('.size-selector select');
            const finalSize = selectedSizeSelect ? selectedSizeSelect.value : selectedSize;
            
            // Добавляем в корзину
            addToCart(productId, 1, selectedColor, finalSize);
            
            // Визуальный эффект
            this.innerHTML = '<i class="bi bi-check"></i> Добавлено';
            this.classList.remove('btn-primary');
            this.classList.add('btn-success');
            
            setTimeout(() => {
                this.innerHTML = '<i class="bi bi-cart-plus"></i> В корзину';
                this.classList.remove('btn-success');
                this.classList.add('btn-primary');
            }, 2000);
        });
    });
    
    // Обновление выбранного цвета
    document.querySelectorAll('.color-option').forEach(option => {
        option.addEventListener('click', function() {
            const container = this.closest('.color-selector');
            const color = this.querySelector('small')?.textContent || this.title;
            container.querySelectorAll('.color-option').forEach(opt => {
                opt.classList.remove('selected');
            });
            this.classList.add('selected');
            container.querySelector('.selected-color').value = color;
            container.querySelector('.selected-color-text').textContent = color;
        });
    });
    
    // Обновление цены при выборе размера
    document.querySelectorAll('.size-selector select').forEach(select => {
        select.addEventListener('change', function() {
            const selectedOption = this.options[this.selectedIndex];
            const priceElement = this.closest('.card-body').querySelector('.price');
            
            if (selectedOption.dataset.price) {
                priceElement.textContent = Number(selectedOption.dataset.price).toLocaleString('ru-RU') + ' ₽';
                // Обновляем скрытое поле для размера
                this.closest('.card-body').querySelector('.selected-size').value = this.value;
            }
        });
    });
});

// Функция для модального окна (если нужно)
function showProductDetails(button) {
    try {
        const product = JSON.parse(button.dataset.product);
        // Здесь код для заполнения модального окна
        console.log('Product details:', product);
    } catch (e) {
        console.error('Error parsing product data:', e);
    }
}
    // Инициализация слайдера цен
    document.addEventListener('DOMContentLoaded', function() {
        const priceSlider = document.getElementById('price-slider');
        const minPriceInput = document.getElementById('min-price');
        const maxPriceInput = document.getElementById('max-price');
        
        if (priceSlider) {
            noUiSlider.create(priceSlider, {
                start: [<?= $min_price ?>, <?= $max_price ?>],
                connect: true,
                range: {
                    'min': <?= $global_min_price ?>,
                    'max': <?= $global_max_price ?>
                },
                step: 100,
                format: {
                    to: value => Math.round(value),
                    from: value => Number(value)
                }
            });
            
            priceSlider.noUiSlider.on('update', values => {
                minPriceInput.value = Math.round(values[0]);
                maxPriceInput.value = Math.round(values[1]);
            });
            
            priceSlider.noUiSlider.on('change', () => {
                document.getElementById('filterForm').submit();
            });
        }
    });
    
    // Выбор цвета
    function selectColor(element, color) {
        const container = element.closest('.color-selector');
        container.querySelectorAll('.color-option').forEach(opt => {
            opt.classList.remove('selected');
        });
        element.classList.add('selected');
        container.querySelector('.selected-color').value = color;
        container.querySelector('.selected-color-text').textContent = color;
    }
    
    // Обновление цены при выборе размера
    function updatePrice(select, basePrice) {
        const selectedOption = select.options[select.selectedIndex];
        const priceElement = select.closest('.card-body').querySelector('.price');
        
        if (selectedOption.dataset.price) {
            priceElement.textContent = Number(selectedOption.dataset.price).toLocaleString('ru-RU') + ' ₽';
        } else {
            priceElement.textContent = basePrice.toLocaleString('ru-RU') + ' ₽';
        }
    }
    
    
    // Показ деталей товара
    function showProductDetails(button) {
        try {
            const product = JSON.parse(button.dataset.product);
            
            document.getElementById('modalProductTitle').textContent = product.name;
            document.getElementById('modalProductImage').src = product.picture || 'https://via.placeholder.com/500x400?text=Нет+изображения';
            document.getElementById('modalProductPrice').textContent = product.price + ' ₽';
            document.getElementById('modalProductCategory').textContent = product.category_name;
            document.getElementById('modalProductArticle').textContent = product.article;
            document.getElementById('modalProductArticleBadge').textContent = product.article;
            document.getElementById('modalProductModel').textContent = product.model || '—';
            document.getElementById('modalProductColor').textContent = product.color || '—';
            document.getElementById('modalProductManufacturer').textContent = product.manufacturer || '—';
            document.getElementById('modalProductDoorType').textContent = product.door_type || '—';
            document.getElementById('modalProductStyle').textContent = product.style || '—';
            document.getElementById('modalProductSizes').textContent = product.size || '—';
            document.getElementById('modalProductDescription').innerHTML = product.description || 'Описание отсутствует';
            
            const availability = document.getElementById('modalProductAvailability');
            if (product.quantity > 0) {
                availability.innerHTML = '<span class="badge bg-success">В наличии (' + product.quantity + ' шт.)</span>';
            } else {
                availability.innerHTML = '<span class="badge bg-danger">Нет в наличии</span>';
            }
        } catch (e) {
            console.error('Ошибка загрузки товара:', e);
        }
    }
    
    // Обновление сортировки
    function updateSorting(value) {
        document.getElementById('sortField').value = value;
        document.getElementById('filterForm').submit();
    }
    
    // Обновление сортировки при выборе категории
    function updateCategorySort(categoryName) {
        const sortField = document.getElementById('sortField');
        const sortSelect = document.getElementById('sortSelect');
        
        if (categoryName) {
            sortField.value = 'name_asc';
            sortSelect.value = 'name_asc';
        } else {
            sortField.value = 'price_asc';
            sortSelect.value = 'price_asc';
        }
        
        document.getElementById('filterForm').submit();
    }
    
    // Переключение вида
    function setViewMode(mode) {
        const container = document.getElementById('productsContainer');
        const items = container.querySelectorAll('.product-item');
        const buttons = document.querySelectorAll('.btn-view');
        
        buttons.forEach(btn => btn.classList.remove('active'));
        event.target.classList.add('active');
        
        items.forEach(item => {
            if (mode === 'list') {
                container.classList.add('list-view');
                item.classList.remove('col-md-6', 'col-xl-4');
                item.classList.add('col-12', 'mb-3');
            } else {
                container.classList.remove('list-view');
                item.classList.remove('col-12', 'mb-3');
                item.classList.add('col-md-6', 'col-xl-4');
            }
        });
    }
    
    // Обработка ошибок изображений
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('img').forEach(img => {
            img.onerror = function() {
                this.src = 'https://via.placeholder.com/400x300?text=Нет+изображения';
            }
        });
    });
    </script>
</body>
</html>